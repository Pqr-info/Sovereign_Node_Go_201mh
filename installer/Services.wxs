<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Component Id="SWENDService" Guid="d859fd2e-3c7b-4a3d-b8c2-12e34fa96b82" Directory="SwendCoreDir">
      <ServiceInstall
          Id="SWENDServiceInstaller"
          Name="SWENDService"
          DisplayName="SWEND Daemon Service"
          Description="Runs the SWEND Sovereign Node background daemon"
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Arguments="-ExecutionPolicy Bypass -File &quot;[#swend_service_ps1]&quot;" />

      <ServiceControl
          Id="SWENDServiceControl"
          Name="SWENDService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>

    <Component Id="MeshService" Guid="f859a2de-4c7b-4d3a-b8c2-12f3496ba7e2" Directory="MeshDir">
      <ServiceInstall
          Id="MeshServiceInstaller"
          Name="SWENDMeshService"
          DisplayName="SWEND Mesh Service"
          Description="Runs the SWEND-MESH network control plane"
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Arguments="--service" />

      <ServiceControl
          Id="MeshServiceControl"
          Name="SWENDMeshService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>

    <Component Id="SubstrateService" Guid="a859b2ce-5d7b-4e3a-b8c2-12a3486ba7f2" Directory="SubstrateDir">
      <ServiceInstall
          Id="SubstrateServiceInstaller"
          Name="SubstrateEngineService"
          DisplayName="Substrate Engine Service"
          Description="Runs the Substrate neural core and inference model"
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Arguments="--service" />

      <ServiceControl
          Id="SubstrateServiceControl"
          Name="SubstrateEngineService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>

    <Component Id="VaultAgentService" Guid="b859c2de-6e7b-4f3a-b8c2-12b3476ba7e2" Directory="VaultDir">
      <ServiceInstall
          Id="VaultAgentServiceInstaller"
          Name="VaultAgentService"
          DisplayName="Vault Agent Service"
          Description="Manages HashiCorp Vault token auto-auth and secrets rendering"
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Arguments="-ExecutionPolicy Bypass -File &quot;[#vault_agent_service_ps1]&quot;" />

      <ServiceControl
          Id="VaultAgentServiceControl"
          Name="VaultAgentService"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>

    <Component Id="Gemma4Service" Guid="e859c2de-7e7b-4f3a-b8c2-12b3476ba7e3" Directory="Gemma4Dir">
      <ServiceInstall
          Id="Gemma4ServiceInstaller"
          Name="Gemma4Service"
          DisplayName="Gemma-4-e4b Brain Agent Service"
          Description="Runs the Gemma-4-e4b Brain Agent for background inference and planning"
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Arguments="-ExecutionPolicy Bypass -File &quot;[#gemma4_service_ps1]&quot;" />

      <ServiceControl
          Id="Gemma4ServiceControl"
          Name="Gemma4Service"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
    </Component>
  </Fragment>
</Wix>
