3. Selector Resolution (Compose-first, Espresso fallback)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par private fun resolve(selector: Selector?): UiTarget \{
\par     if (selector == null) throw IllegalArgumentException("Selector required")
\par 
\par     // Compose priority
\par     selector.compose_test_id?.let \{
\par         return UiTarget.Compose(composeRule.onNodeWithTag(it))
\par     \}
\par     selector.compose_tag?.let \{
\par         return UiTarget.Compose(composeRule.onNode(hasAnyChild(hasTestTag(it))))
\par     \}
\par 
\par     // Espresso fallback
\par     selector.id?.let \{
\par         return UiTarget.Espresso(espresso.onView(withId(resolveId(it))))
\par     \}
\par     selector.text?.let \{
\par         return UiTarget.Espresso(espresso.onView(withText(it)))
\par     \}
\par     selector.content_desc?.let \{
\par         return UiTarget.Espresso(espresso.onView(withContentDescription(it)))
\par     \}
\par 
\par     throw IllegalArgumentException("No valid selector fields found")
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 UiTarget sealed class
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par sealed class UiTarget \{
\par     class Compose(val node: SemanticsNodeInteraction) : UiTarget()
\par     class Espresso(val view: ViewInteraction) : UiTarget()
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 4. Action Implementations
\par }{\rtlch\fcs1 \ab\af46 \ltrch\fcs0 \b\f46\insrsid7026199\charrsid7026199 \u10004\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  Click
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par override fun click(selector: Selector?) \{
\par     when (val target = resolve(selector)) \{
\par         is UiTarget.Compose -> target.node.performClick()
\par         is UiTarget.Espresso -> target.view.perform(click())
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af46 \ltrch\fcs0 \b\f46\insrsid7026199\charrsid7026199 \u10004\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  Long Click
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par override fun longClick(selector: Selector?) \{
\par     when (val target = resolve(selector)) \{
\par         is UiTarget.Compose -> target.node.performSemanticsAction(SemanticsActions.OnLongClick)
\par         is UiTarget.Espresso -> target.view.perform(longClick())
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af46 \ltrch\fcs0 \b\f46\insrsid7026199\charrsid7026199 \u10004\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  Type
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par override fun type(selector: Selector?, text: String) \{
\par     when (val target = resolve(selector)) \{
\par         is UiTarget.Compose -> target.node.performTextInput(text)
\par         is UiTarget.Espresso -> target.view.perform(typeText(text), closeSoftKeyboard())
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af46 \ltrch\fcs0 \b\f46\insrsid7026199\charrsid7026199 \u10004\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  Scroll
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par override fun scroll(selector: Selector?, direction: String?, amount: Double?) \{
\par     val amt = amount ?: 0.5
\par 
\par     when (val target = resolve(selector)) \{
\par         is UiTarget.Compose -> \{
\par             when (direction) \{
\par                 "up" -> target.node.performScrollTo()
\par                 "down" -> target.node.performScrollTo()
\par             \}
\par         \}
\par         is UiTarget.Espresso -> \{
\par             when (direction) \{
\par                 "up" -> target.view.perform(swipeUp())
\par                 "down" -> target.view.perform(swipeDown())
\par             \}
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af46 \ltrch\fcs0 \b\f46\insrsid7026199\charrsid7026199 \u10004\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  Swipe
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par override fun swipe(selector: Selector?, direction: String?, amount: Double?) \{
\par     when (val target = resolve(selector)) \{
\par         is UiTarget.Compose -> \{
\par             // Compose doesn't have native swipe; use scroll semantics
\par             scroll(selector, direction, amount)
\par         \}
\par         is UiTarget.Espresso -> \{
\par             when (direction) \{
\par                 "left" -> target.view.perform(swipeLeft())
\par                 "right" -> target.view.perform(swipeRight())
\par             \}
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af46 \ltrch\fcs0 \b\f46\insrsid7026199\charrsid7026199 \u10004\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  Navigate
