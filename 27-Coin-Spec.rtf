\par python
\par import time
\par import requests
\par 
\par API_BASE = "http://localhost:8000"
\par POLL_INTERVAL = 2.0  # seconds
\par 
\par AGENT_ID = "antigravity"  # or "gemma", etc.
\par 
\par def fetch_open_timeslips():
\par     resp = requests.get(f"\{API_BASE\}/explorer/timeslip_timeline")
\par     resp.raise_for_status()
\par     timeline = resp.json()
\par     return [t for t in timeline if t["status"] == "OPEN" and t.get("assigned_to") == AGENT_ID]
\par 
\par def post_timeslip_reply(timeslip_id: int, body: str, author: str):
\par     payload = \{
\par         "timeslip_id": timeslip_id,
\par         "body": body,
\par         "author": author,
\par     \}
\par     resp = requests.post(f"\{API_BASE\}/timeslips/\{timeslip_id\}/reply", json=payload)
\par     resp.raise_for_status()
\par     return resp.json()
\par 
\par def process_timeslip(ts):
\par     # Here you route to Antigravity / Gemma / Copilot, etc.
\par     # For now, a simple echo reply:
\par     reply_body = f"[\{AGENT_ID\}] processed timeslip '\{ts['title']\}' at checkpoint \{ts['checkpoint_id']\}."
\par     print(f"Replying to timeslip \{ts['id']\}: \{reply_body\}")
\par     post_timeslip_reply(timeslip_id=ts["id"], body=reply_body, author=AGENT_ID)
\par 
\par def main():
\par     print("TimeslipWatcher daemon starting\'85")
\par     while True:
\par         try:
\par             open_ts = fetch_open_timeslips()
\par             for ts in open_ts:
\par                 process_timeslip(ts)
\par         except Exception as e:
\par             print(f"TimeslipWatcher error: \{e\}")
\par         time.sleep(POLL_INTERVAL)
\par 
\par if __name__ == "__main__":
\par     main()
