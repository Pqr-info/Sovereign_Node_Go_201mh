\par }\pard \ltrpar\ql \li0\ri0\sa160\sl278\slmult1\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid7026199 {\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 
