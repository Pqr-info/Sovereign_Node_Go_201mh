\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Serializable
\par data class McpToolRequest(
\par     val tool: String,
\par     val arguments: JsonObject
\par )
\par 
\par @Serializable
\par data class McpToolResponse(
