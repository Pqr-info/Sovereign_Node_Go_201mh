\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par override fun waitFor(selector: Selector?, timeoutMs: Long) \{
\par     val start = System.currentTimeMillis()
\par 
\par     while (System.currentTimeMillis() - start < timeoutMs) \{
\par         try \{
\par             assertVisible(selector, 50)
