\par from dataclasses import dataclass
\par from typing import List, Dict, Optional
\par 
\par @dataclass
\par class Step:
\par     action: str
\par     selector: Optional[Dict] = None
\par     input: Optional[str] = None
\par     direction: Optional[str] = None
\par     amount: Optional[float] = None
\par     timeout_ms: Optional[int] = None
\par     expect: Optional[Dict] = None  # expectations on ui_get_state
\par 
\par @dataclass
\par class Scenario:
\par     name: str
\par     steps: List[Step]
\par Example scenario:
\par python
\par login_and_open_ticket = Scenario(
\par     name="login_and_open_ticket",
\par     steps=[
\par         Step(action="type", selector=\{"id": "username_field"\}, input="alan"),
\par         Step(action="type", selector=\{"id": "password_field"\}, input="secret"),
\par         Step(action="click", selector=\{"text": "Login"\}),
\par         Step(
\par             action="wait_for",
\par             selector=\{"compose_test_id": "ticket_list_root"\},
\par             timeout_ms=5000,
\par         ),
\par         Step(
\par             action="click",
\par             selector=\{"text": "PQR-2026-00012"\},
\par         ),
\par         Step(
\par             action="assert",
\par             selector=\{"compose_test_id": "block_lens_root"\},
\par             timeout_ms=5000,
\par             expect=\{"screen.name": "TicketDetailScreen"\},
\par         ),
\par     ],
\par )
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 4. Runner
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 python
\par class ScenarioRunner:
\par     def __init__(self, mcp: McpClient, reporter):
\par         self.mcp = mcp
\par         self.reporter = reporter
\par 
\par     def run(self, scenario: Scenario):
\par         for idx, step in enumerate(scenario.steps):
\par             try:
\par                 self._execute_step(step)
\par                 if step.expect:
\par                     self._check_expectations(step.expect)
\par             except Exception as e:
\par                 self.reporter.report_failure(scenario, step, idx, str(e))
\par                 break
\par 
\par     def _execute_step(self, step: Step):
\par         args = \{
\par             "action": step.action,
\par         \}
\par         if step.selector:
\par             args["selector"] = step.selector
\par         if step.input is not None:
\par             args["input"] = step.input
\par         if step.direction is not None:
\par             args["direction"] = step.direction
\par         if step.amount is not None:
\par             args["amount"] = step.amount
\par         if step.timeout_ms is not None:
\par             args["timeout_ms"] = step.timeout_ms
\par 
\par         res = self.mcp.execute("ui_walkthrough_step", args)
\par         if res.get("status") != "ok":
\par             raise RuntimeError(res.get("error", "unknown error"))
\par 
\par     def _check_expectations(self, expect: Dict):
\par         state = self.mcp.execute("ui_get_state", \{"include_screenshot": False\})
\par         data = state.get("data", \{\})
\par         # simple dot-path expectation checking
\par         for path, value in expect.items():
\par             if self._get_path(data, path) != value:
\par                 raise AssertionError(f"Expectation failed: \{path\} != \{value\}")
\par 
\par     def _get_path(self, obj, path: str):
\par         parts = path.split(".")
\par         cur = obj
\par         for p in parts:
\par             if isinstance(cur, dict):
\par                 cur = cur.get(p)
\par             else:
\par                 return None
\par         return cur
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 5. Reporter \u8594\'3f V10 ticket pipeline
