\par import requests
\par 
\par class McpClient:
\par     def __init__(self, base_url: str):
\par         self.base_url = base_url
\par 
\par     def execute(self, tool: str, arguments: dict) -> dict:
\par         resp = requests.post(
\par             f"\{self.base_url\}/mcp/execute",
\par             json=\{"tool": tool, "arguments": arguments\},
\par             timeout=10,
\par         )
\par         resp.raise_for_status()
\par         return resp.json()
