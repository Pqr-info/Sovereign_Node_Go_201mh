\par     val data: JsonElement? = null,
\par     val error: String? = null
\par )
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 2.4 Tool dispatch (core handler)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par fun handleToolRequest(request: McpToolRequest): McpToolResponse \{
\par     return when (request.tool) \{
\par         "mesh_get_ticket" -> MeshTools.getTicket(request.arguments)
\par         "mesh_get_ticket_lens" -> MeshTools.getTicketLens(request.arguments)
\par         "mesh_get_block_lens" -> MeshTools.getBlockLens(request.arguments)
\par         "mesh_get_chain_head" -> MeshTools.getChainHead()
\par         "mesh_archive_ticket" -> MeshTools.archiveTicketWithConfirmation(request.arguments)
\par 
\par         "device_get_telemetry" -> DeviceTools.getTelemetry(context)
\par         "device_get_location" -> DeviceTools.getLocation(context)
\par 
\par         "ui_push_notification" -> UiTools.pushNotification(context, request.arguments)
\par         "ui_navigate_to_ticket" -> UiTools.navigateToTicket(context, request.arguments)
\par 
\par         "sensor_read_camera_frame" -> SensorTools.readCameraFrame(context, request.arguments)
\par 
\par         else -> McpToolResponse(
\par             status = "error",
\par             error = "Unknown tool: $\{request.tool\}"
\par         )
\par     \}
\par \}
