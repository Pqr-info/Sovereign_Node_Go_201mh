\par             index=e.index,
\par             section=e.section,
\par             method=e.method,
\par             data=e.data,
\par         )
\par         for e in events_raw
\par     ]
\par 
\par     chain = ChainContextModel(
\par         block=BlockSummaryModel(
\par             block_number=block.block_number,
\par             block_hash=block.block_hash,
\par             timestamp=block.timestamp,
\par         ),
\par         extrinsic=ExtrinsicSummaryModel(
\par             index=extrinsic.index,
\par             hash=extrinsic.hash,
\par             section=extrinsic.section,
\par             method=extrinsic.method,
\par         ),
\par         events=events,
\par     )
\par 
\par     # 6. Assemble TicketLens
\par     metadata = TicketMetadataModel(
\par         synthetic_id=ticket.synthetic_id,
\par         title=ticket.title,
\par         priority=ticket.priority,
\par         status=ticket.status,
\par         created_at=ticket.created_at,
\par         created_by=ticket.created_by,
\par         assigned_to=ticket.assigned_to,
\par         block_number=ticket.block_number,
\par         extrinsic_index=ticket.extrinsic_index,
\par     )
\par 
\par     lens = TicketLensModel(
