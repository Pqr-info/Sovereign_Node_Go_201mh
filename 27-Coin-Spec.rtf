\par     pub type RelationId = u64;
\par     pub type AgentId = BoundedVec<u8, ConstU32<64>>;
\par 
\par     #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par     pub enum RelationTarget \{
\par         Ticket(TicketId),
\par         Agent(AgentId),
\par         Decision(TicketId),
\par     \}
\par 
\par     #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par     pub enum RelationKind \{
\par         DependsOn,
\par         Mentions,
\par         AssignedTo,
\par         DerivedFrom,
\par         DuplicateOf,
\par         RelatedTo,
\par     \}
\par 
\par     #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par     pub struct RelationEdge \{
\par         pub id: RelationId,
\par         pub from: TicketId,
\par         pub to: RelationTarget,
\par         pub kind: RelationKind,
\par     \}
\par 
\par     #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par     pub struct TicketMetadata \{
\par         pub ticket_id: TicketId,
\par         pub synthetic_id: BoundedVec<u8, ConstU32<64>>,
\par         pub title: BoundedVec<u8, ConstU32<256>>,
\par         pub priority: u8,
\par         pub status: BoundedVec<u8, ConstU32<32>>,
\par         pub created_at: u64,
\par         pub created_by: AgentId,
\par         pub assigned_to: Option<AgentId>,
\par         pub block_number: u32,
\par         pub extrinsic_index: u32,
\par     \}
\par 
\par     #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par     pub struct TicketReply \{
\par         pub id: u64,
\par         pub ticket_id: TicketId,
\par         pub author: AgentId,
\par         pub body: BoundedVec<u8, ConstU32<1024>>,
\par         pub created_at: u64,
\par     \}
\par 
\par     #[pallet::config]
\par     pub trait Config: frame_system::Config \{
\par         type RuntimeEvent: From<Event<Self>> + IsType<<Self as frame_system::Config>::RuntimeEvent>;
\par 
\par         #[pallet::constant]
\par         type MaxRelationsPerTicket: Get<u32>;
\par 
\par         #[pallet::constant]
\par         type MaxTicketsPerAgent: Get<u32>;
\par 
\par         #[pallet::constant]
\par         type MaxRepliesPerTicket: Get<u32>;
\par     \}
\par 
\par     #[pallet::storage]
\par     pub type Tickets<T: Config> =
\par         StorageMap<_, Blake2_128Concat, TicketId, TicketMetadata, OptionQuery>;
\par 
\par     #[pallet::storage]
\par     pub type TicketRelations<T: Config> =
\par         StorageMap<_, Blake2_128Concat, TicketId, BoundedVec<RelationEdge, T::MaxRelationsPerTicket>, ValueQuery>;
\par 
\par     #[pallet::storage]
\par     pub type TicketReplies<T: Config> =
\par         StorageMap<_, Blake2_128Concat, TicketId, BoundedVec<TicketReply, T::MaxRepliesPerTicket>, ValueQuery>;
\par 
\par     #[pallet::storage]
\par     pub type AgentTickets<T: Config> =
\par         StorageMap<_, Blake2_128Concat, AgentId, BoundedVec<TicketId, T::MaxTicketsPerAgent>, ValueQuery>;
\par 
\par     #[pallet::storage]
\par     pub type NextTicketId<T: Config> =
\par         StorageValue<_, TicketId, ValueQuery>;
\par 
\par     #[pallet::storage]
\par     pub type NextRelationId<T: Config> =
\par         StorageValue<_, RelationId, ValueQuery>;
