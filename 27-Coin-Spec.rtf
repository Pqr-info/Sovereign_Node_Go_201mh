\par             ticket_id: TicketId,
\par             who: T::AccountId,
\par         \},
\par         RelationAdded \{
\par             relation_id: RelationId,
\par             from_ticket: TicketId,
\par             to: RelationTarget,
\par             kind: RelationKind,
\par         \},
\par         TicketReplied \{
\par             ticket_id: TicketId,
\par         \},
\par     \}
\par 
\par     #[pallet::error]
\par     pub enum Error<T> \{
\par         UnknownTicket,
\par         TooManyRelationsPerTicket,
\par         TooManyTicketsForAgent,
\par         TooManyRepliesPerTicket,
\par     \}
\par 
\par     #[pallet::genesis_config]
\par     pub struct GenesisConfig<T: Config> \{
\par         pub _phantom: PhantomData<T>,
\par     \}
\par 
