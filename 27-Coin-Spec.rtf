\par         origin: OriginFor<T>,
\par         metadata: TicketMetadataInput, // a lighter input type
\par     ) -> DispatchResult \{
\par         let who = ensure_signed(origin)?;
\par 
\par         let ticket_id = NextTicketId::<T>::get();
\par         NextTicketId::<T>::put(ticket_id + 1);
\par 
\par         let meta = TicketMetadata \{
\par             ticket_id,
\par             synthetic_id: metadata.synthetic_id,
\par             title: metadata.title,
\par             priority: metadata.priority,
\par             status: b"open".to_vec().try_into().unwrap(),
\par             created_at: metadata.created_at,
\par             created_by: metadata.created_by,
\par             assigned_to: metadata.assigned_to,
\par             block_number: <frame_system::Pallet<T>>::block_number().saturated_into::<u32>(),
\par             extrinsic_index: metadata.extrinsic_index,
\par         \};
\par 
\par         Tickets::<T>::insert(ticket_id, meta);
\par 
\par         if let Some(agent) = meta.assigned_to.clone() \{
\par             let mut list = AgentTickets::<T>::get(agent.clone());
\par             if !list.contains(&ticket_id) \{
\par                 list.try_push(ticket_id).map_err(|_| Error::<T>::TooManyTicketsForAgent)?;
\par                 AgentTickets::<T>::insert(agent, list);
\par             \}
\par         \}
\par 
\par         TicketRelations::<T>::insert(ticket_id, BoundedVec::default());
\par 
\par         Self::deposit_event(Event::TicketArchived \{ ticket_id, who \});
\par 
\par         Ok(())
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 b) add_relation (graph edge creation)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 This is how you encode @mentions, dependencies, cross-ticket links, etc.
\par rust
\par #[pallet::call]
\par impl<T: Config> Pallet<T> \{
\par     #[pallet::call_index(1)]
\par     #[pallet::weight(10_000)]
\par     pub fn add_relation(
\par         origin: OriginFor<T>,
\par         from_ticket: TicketId,
\par         to: RelationTarget,
\par         kind: RelationKind,
\par     ) -> DispatchResult \{
\par         let _who = ensure_signed(origin)?;
\par 
\par         ensure!(Tickets::<T>::contains_key(from_ticket), Error::<T>::UnknownTicket);
\par 
\par         let relation_id = NextRelationId::<T>::get();
\par         NextRelationId::<T>::put(relation_id + 1);
\par 
\par         let edge = RelationEdge \{
\par             id: relation_id,
\par             from: from_ticket,
\par             to: to.clone(),
\par             kind,
\par         \};
\par 
\par         TicketRelations::<T>::mutate(from_ticket, |edges| \{
\par             edges.try_push(edge).map_err(|_| Error::<T>::TooManyRelationsPerTicket)
\par         \})?;
\par 
\par         Self::deposit_event(Event::RelationAdded \{
\par             relation_id,
\par             from_ticket,
\par             to,
\par             kind,
\par         \});
\par 
\par         Ok(())
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 c) Optional: reply_ticket (threaded replies)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 If you want replies on-chain too:
\par rust
\par #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par pub struct TicketReply \{
\par     pub id: u64,
\par     pub ticket_id: TicketId,
\par     pub author: AgentId,
\par     pub body: BoundedVec<u8, ConstU32<1024>>,
\par     pub created_at: u64,
\par \}
\par 
\par #[pallet::storage]
\par pub type TicketReplies<T: Config> =
\par     StorageMap<_, Blake2_128Concat, TicketId, BoundedVec<TicketReply, T::MaxRepliesPerTicket>, ValueQuery>;
\par And an extrinsic:
\par rust
\par #[pallet::call_index(2)]
\par #[pallet::weight(10_000)]
\par pub fn reply_ticket(
\par     origin: OriginFor<T>,
\par     ticket_id: TicketId,
\par     body: BoundedVec<u8, ConstU32<1024>>,
\par     author: AgentId,
\par ) -> DispatchResult \{
\par     let _who = ensure_signed(origin)?;
\par     ensure!(Tickets::<T>::contains_key(ticket_id), Error::<T>::UnknownTicket);
\par 
\par     let reply = TicketReply \{
\par         id: /* increment from storage or off-chain */,
\par         ticket_id,
\par         author,
\par         body,
\par         created_at: /* timestamp from off-chain or block number */,
\par     \};
\par 
\par     TicketReplies::<T>::mutate(ticket_id, |replies| \{
\par         replies.try_push(reply).map_err(|_| Error::<T>::TooManyRepliesPerTicket)
\par     \})?;
\par 
\par     Self::deposit_event(Event::TicketReplied \{ ticket_id \});
\par 
\par     Ok(())
\par \}
