\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 Timeslip extrinsic signing (open/close)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 tsx
\par import \{ usePolkadot \} from "../polkadot/PolkadotContext";
\par import \{ web3FromSource \} from "@polkadot/extension-dapp";
\par 
\par type OpenTimeslipParams = \{
\par   title: string;
\par   checkpointId: string;
\par   billable: boolean;
\par   rate: number;
\par \};
\par 
\par export function useTimeslipExtrinsics() \{
\par   const \{ api, selected, accounts \} = usePolkadot();
\par 
\par   const openTimeslip = async (params: OpenTimeslipParams) => \{
\par     if (!api || !selected) return;
\par 
\par     const acc = accounts.find(a => a.address === selected);
\par     if (!acc) return;
\par 
\par     const injector = await web3FromSource(acc.meta.source);
\par     const signer = injector.signer;
\par 
\par     const call = api.tx.timeslips.openTimeslip(\{
\par       title: params.title,
\par       checkpointId: params.checkpointId,
\par       billable: params.billable,
\par       rate: params.rate,
\par     \});
\par 
\par     await call.signAndSend(selected, \{ signer \});
\par   \};
\par 
\par   const closeTimeslip = async (timeslipId: number, cost: number, rollbackNote?: string) => \{
\par     if (!api || !selected) return;
\par 
\par     const acc = accounts.find(a => a.address === selected);
\par     if (!acc) return;
\par 
\par     const injector = await web3FromSource(acc.meta.source);
\par     const signer = injector.signer;
\par 
\par     const call = api.tx.timeslips.closeTimeslip(timeslipId, cost, rollbackNote || "");
\par 
\par     await call.signAndSend(selected, \{ signer \});
\par   \};
\par 
\par   return \{ openTimeslip, closeTimeslip \};
\par \}
\par Use useTimeslipExtrinsics in your Open Timeslip modal and Timeslip detail view.
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 2. Explorer Engine RPC bindings & Timeslip timeline hydration
\par explorer/substrate_adapter.py (Timeslips RPC)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 python
\par from substrateinterface import SubstrateInterface
\par 
\par substrate = SubstrateInterface(
\par     url="ws://127.0.0.1:9944",
\par     ss58_format=42,
\par     type_registry_preset="substrate-node-template"
\par )
\par 
\par def get_timeslip(timeslip_id: int):
\par     result = substrate.query(
\par         module="Timeslips",
\par         storage_function="Timeslips",
\par         params=[timeslip_id]
\par     )
\par     return result.value  # dict or None
\par 
\par def get_timeslip_relations(timeslip_id: int):
\par     result = substrate.query(
\par         module="Timeslips",
\par         storage_function="TimeslipRelations",
\par         params=[timeslip_id]
\par     )
\par     return result.value or []
\par 
\par def get_timeslip_replies(timeslip_id: int):
\par     result = substrate.query(
\par         module="Timeslips",
\par         storage_function="TimeslipReplies",
\par         params=[timeslip_id]
\par     )
\par     return result.value or []
\par 
\par def get_all_timeslips():
\par     # assuming you have a TimeslipCount or iterate keys off-chain
\par     # simplest: off-chain index or separate storage map
\par     # here we assume TimeslipCount exists
\par     count = substrate.query(
\par         module="Timeslips",
\par         storage_function="TimeslipCount"
\par     ).value or 0
\par 
\par     timeslips = []
\par     for tid in range(count):
\par         ts = get_timeslip(tid)
\par         if ts:
\par             timeslips.append(ts)
\par     return timeslips
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 explorer/timeslip_lens.py (timeline hydration)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 python
\par from typing import List, Dict, Any
\par from . import substrate_adapter
\par from . import block_lens, extrinsic_lens
\par import schema_v10  # reuse for normalized/raw if you keep V10
\par 
\par def get_timeslip_lens(timeslip_id: int) -> Dict[str, Any]:
\par     ts = substrate_adapter.get_timeslip(timeslip_id)
\par     if ts is None:
\par         return \{"status": "error", "timeslip_id": timeslip_id\}
\par 
\par     relations_raw = substrate_adapter.get_timeslip_relations(timeslip_id)
\par     replies_raw = substrate_adapter.get_timeslip_replies(timeslip_id)
\par 
\par     relations = []
\par     for edge in relations_raw:
\par         relations.append(\{
\par             "id": edge["id"],
\par             "from": edge["from"],
\par             "to": \{
\par                 "type": edge["to"]["type"],
\par                 "value": edge["to"]["value"],
\par             \},
\par             "kind": edge["kind"],
\par         \})
\par 
\par     replies = []
\par     for r in replies_raw:
\par         replies.append(\{
\par             "id": r["id"],
\par             "timeslip_id": r["timeslip_id"],
\par             "author": r["author"],
\par             "body": r["body"],
\par             "created_at": r["created_at"],
\par         \})
\par 
\par     # optional: V10 normalized/raw if you keep that pipeline
\par     v10_norm, v10_raw = schema_v10.load_ticket(ts["synthetic_id"]) if "synthetic_id" in ts else (\{\}, \{\})
\par 
\par     block = block_lens.get_block_summary(block_number=ts["block_number"])
\par     extrinsic = extrinsic_lens.get_extrinsic_summary(
\par         block_number=ts["block_number"],
\par         extrinsic_index=ts["extrinsic_index"],
\par     )
\par     events_raw = block_lens.get_events_for_extrinsic(
\par         block_number=ts["block_number"],
\par         extrinsic_index=ts["extrinsic_index"],
\par     )
\par 
\par     events = [
\par         \{
\par             "index": e.index,
\par             "section": e.section,
\par             "method": e.method,
\par             "data": e.data,
\par         \}
\par         for e in events_raw
\par     ]
\par 
\par     return \{
\par         "status": "ok",
\par         "timeslip_id": timeslip_id,
\par         "metadata": \{
\par             "title": ts["title"],
\par             "status": ts["status"],
\par             "checkpoint_id": ts["checkpoint_id"],
\par             "billable": ts["billable"],
\par             "rate": ts["rate"],
\par             "start": ts["start"],
\par             "end": ts["end"],
\par             "cost": ts["cost"],
\par             "rollback_note": ts["rollback_note"],
\par             "created_by": ts["created_by"],
\par             "assigned_to": ts.get("assigned_to"),
\par             "block_number": ts["block_number"],
\par             "extrinsic_index": ts["extrinsic_index"],
\par         \},
\par         "relations": relations,
\par         "replies": replies,
\par         "v10": \{
\par             "normalized": v10_norm,
\par             "raw": v10_raw,
\par         \},
\par         "chain": \{
\par             "block": \{
\par                 "block_number": block.block_number,
\par                 "block_hash": block.block_hash,
\par                 "timestamp": block.timestamp,
\par             \},
\par             "extrinsic": \{
\par                 "index": extrinsic.index,
\par                 "hash": extrinsic.hash,
\par                 "section": extrinsic.section,
\par                 "method": extrinsic.method,
\par             \},
\par             "events": events,
\par         \},
\par     \}
\par 
\par def get_timeslip_timeline() -> List[Dict[str, Any]]:
\par     timeslips = substrate_adapter.get_all_timeslips()
\par     # hydrate minimal timeline entries
\par     timeline = []
\par     for ts in timeslips:
\par         timeline.append(\{
\par             "id": ts["timeslip_id"],
\par             "title": ts["title"],
\par             "status": ts["status"],
\par             "start": ts["start"],
\par             "end": ts["end"],
\par             "billable": ts["billable"],
\par             "cost": ts["cost"],
\par             "checkpoint_id": ts["checkpoint_id"],
\par         \})
\par     # sort by start time
\par     timeline.sort(key=lambda t: t["start"])
\par     return timeline
