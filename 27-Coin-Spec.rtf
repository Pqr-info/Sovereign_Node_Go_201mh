\par 1. Retrofit client for /explorer/block_lens
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par // Api models should mirror your backend Block Lens JSON
\par data class BlockLensDto(
\par     val status: String,
\par     val block: BlockSummaryDto,
\par     val extrinsics: List<ExtrinsicSummaryDto>,
\par     val events: List<EventSummaryDto>,
\par     val tickets: List<TicketSummaryDto>,
\par     val navigation: NavigationDto,
\par     val chainHead: ChainHeadDto
\par )
\par 
\par interface ExplorerApi \{
\par     @GET("/explorer/block_lens")
\par     suspend fun getBlockLens(
\par         @Query("block_hash") blockHash: String? = null,
\par         @Query("block_number") blockNumber: Long? = null
\par     ): BlockLensDto
\par \}
\par 
\par fun provideExplorerApi(baseUrl: String): ExplorerApi \{
\par     val client = OkHttpClient.Builder().build()
\par     val retrofit = Retrofit.Builder()
\par         .baseUrl(baseUrl)
\par         .client(client)
\par         .addConverterFactory(MoshiConverterFactory.create())
\par         .build()
\par     return retrofit.create(ExplorerApi::class.java)
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 2. BlockLensRepository
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par class BlockLensRepository(
\par     private val api: ExplorerApi
\par ) \{
\par 
\par     suspend fun getBlockLensByHash(blockHash: String): BlockLensUi \{
\par         val dto = api.getBlockLens(blockHash = blockHash)
\par         return dto.toUi()
\par     \}
\par 
\par     suspend fun getBlockLensByNumber(blockNumber: Long): BlockLensUi \{
\par         val dto = api.getBlockLens(blockNumber = blockNumber)
\par         return dto.toUi()
\par     \}
\par \}
\par 
\par // Mapping DTO \u8594\'3f UI models (adapt to your existing Ui types)
\par fun BlockLensDto.toUi(): BlockLensUi =
\par     BlockLensUi(
\par         status = status,
\par         block = BlockSummaryUi(
\par             hash = block.hash,
\par             number = block.number,
\par             parentHash = block.parentHash,
\par             author = block.author,
\par             timestamp = block.timestamp,
\par             extrinsicsCount = block.extrinsicsCount,
\par             eventsCount = block.eventsCount
\par         ),
\par         extrinsics = extrinsics.map \{
\par             ExtrinsicSummaryUi(
\par                 index = it.index,
\par                 hash = it.hash,
\par                 callModule = it.callModule,
\par                 callFunction = it.callFunction,
\par                 signer = it.signer,
\par                 isSuccess = it.isSuccess
\par             )
\par         \},
\par         events = events.map \{
\par             EventSummaryUi(
\par                 module = it.module,
\par                 event = it.event,
\par                 data = it.data
\par             )
\par         \},
\par         tickets = tickets.map \{
\par             TicketSummaryUi(
\par                 ticketId = it.ticketId,
\par                 extrinsicIndex = it.extrinsicIndex,
\par                 extrinsicHash = it.extrinsicHash
\par             )
\par         \},
\par         navigation = NavigationUi(
\par             previousBlock = navigation.previousBlock?.let \{
\par                 BlockRefUi(hash = it.hash, number = it.number)
\par             \},
\par             nextBlock = navigation.nextBlock?.let \{
\par                 BlockRefUi(hash = it.hash, number = it.number)
\par             \}
\par         ),
\par         chainHead = ChainHeadUi(
\par             bestHash = chainHead.bestHash,
\par             bestNumber = chainHead.bestNumber,
\par             finalizedHash = chainHead.finalizedHash,
\par             finalizedNumber = chainHead.finalizedNumber,
\par             isSyncing = chainHead.isSyncing
\par         )
\par     )
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 3. BlockLensViewModel with navigation-ready loadBlockLens
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par class BlockLensViewModel(
\par     private val repository: BlockLensRepository
\par ) : ViewModel() \{
\par 
\par     private val _lens = MutableStateFlow<BlockLensUi?>(null)
\par     val lens: StateFlow<BlockLensUi?> = _lens
\par 
\par     private val _loading = MutableStateFlow(false)
\par     val loading: StateFlow<Boolean> = _loading
\par 
\par     private val _error = MutableStateFlow<String?>(null)
\par     val error: StateFlow<String?> = _error
\par 
\par     fun loadBlockLensByHash(blockHash: String) \{
\par         viewModelScope.launch \{
\par             _loading.value = true
\par             _error.value = null
\par             try \{
\par                 _lens.value = repository.getBlockLensByHash(blockHash)
\par             \} catch (e: Exception) \{
\par                 _error.value = e.message
\par             \} finally \{
\par                 _loading.value = false
\par             \}
\par         \}
\par     \}
\par 
\par     fun loadBlockLensByNumber(blockNumber: Long) \{
\par         viewModelScope.launch \{
\par             _loading.value = true
\par             _error.value = null
\par             try \{
\par                 _lens.value = repository.getBlockLensByNumber(blockNumber)
\par             \} catch (e: Exception) \{
\par                 _error.value = e.message
\par             \} finally \{
\par                 _loading.value = false
\par             \}
\par         \}
\par     \}
\par 
\par     fun navigateToBlock(ref: BlockRefUi) \{
\par         // navigation-ready helper: choose hash or number
\par         if (ref.hash.isNotBlank()) \{
\par             loadBlockLensByHash(ref.hash)
\par         \} else \{
\par             loadBlockLensByNumber(ref.number)
\par         \}
\par     \}
\par \}
\par Usage in BlockLensRoot:
\par kotlin
\par @Composable
\par fun BlockLensScreen(
\par     viewModel: BlockLensViewModel
\par ) \{
\par     val lens by viewModel.lens.collectAsState()
\par     val loading by viewModel.loading.collectAsState()
\par     val error by viewModel.error.collectAsState()
\par 
\par     Column \{
\par         if (loading) \{
\par             Text("Loading block lens\'85")
\par         \}
\par         error?.let \{ Text("Error: $it", color = Color.Red) \}
\par 
\par         BlockLensRoot(
\par             lens = lens,
\par             onNavigateToBlock = \{ ref -> viewModel.navigateToBlock(ref) \}
\par         )
\par     \}
\par \}
