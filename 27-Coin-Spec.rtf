\par class RelationTargetModel(BaseModel):
\par     type: Literal["Ticket", "Agent", "Decision"]
\par     value: str | int
\par 
\par class RelationEdgeModel(BaseModel):
\par     id: int
\par     from_: int
\par     to: RelationTargetModel
\par     kind: Literal[
\par         "DependsOn",
\par         "Mentions",
\par         "AssignedTo",
\par         "DerivedFrom",
\par         "DuplicateOf",
\par         "RelatedTo",
\par     ]
\par 
\par     class Config:
\par         fields = \{"from_": "from"\}
\par 
\par class TicketReplyModel(BaseModel):
\par     id: int
\par     ticket_id: int
\par     author: str
\par     body: str
\par     created_at: int
\par 
\par class V10PayloadModel(BaseModel):
\par     normalized: dict
\par     raw: dict
\par 
\par class BlockSummaryModel(BaseModel):
\par     block_number: int
\par     block_hash: str
\par     timestamp: int
\par 
\par class ExtrinsicSummaryModel(BaseModel):
\par     index: int
\par     hash: str
\par     section: str
\par     method: str
\par 
\par class EventSummaryModel(BaseModel):
\par     index: int
\par     section: str
\par     method: str
\par     data: dict
\par 
\par class ChainContextModel(BaseModel):
\par     block: BlockSummaryModel
\par     extrinsic: ExtrinsicSummaryModel
\par     events: List[EventSummaryModel]
\par 
\par class TicketLensModel(BaseModel):
\par     status: Literal["ok", "error"]
\par     ticket_id: int
\par     metadata: TicketMetadataModel
\par     relations: List[RelationEdgeModel]
\par     replies: List[TicketReplyModel]
\par     v10: V10PayloadModel
\par     chain: ChainContextModel
\par 
\par 
\par # --- Endpoint implementation ---
\par 
\par @router.get("/explorer/ticket_lens/\{ticket_id\}", response_model=TicketLensModel)
\par async def get_ticket_lens(ticket_id: int):
\par     # 1. Fetch on-chain ticket metadata
\par     ticket = substrate_adapter.get_ticket_metadata(ticket_id)
\par     if ticket is None:
\par         raise HTTPException(status_code=404, detail="Ticket not found")
\par 
\par     # 2. Fetch relations
\par     relations_raw = substrate_adapter.get_ticket_relations(ticket_id)
\par     relations: List[RelationEdgeModel] = []
\par     for edge in relations_raw:
\par         if edge.to_type == "Ticket":
\par             target = RelationTargetModel(type="Ticket", value=edge.to_value)
\par         elif edge.to_type == "Agent":
\par             target = RelationTargetModel(type="Agent", value=edge.to_value)
\par         elif edge.to_type == "Decision":
\par             target = RelationTargetModel(type="Decision", value=edge.to_value)
\par         else:
\par             continue
\par 
\par         relations.append(
\par             RelationEdgeModel(
\par                 id=edge.id,
\par                 from_=edge.from_ticket,
\par                 to=target,
\par                 kind=edge.kind,
\par             )
\par         )
\par 
\par     # 3. Fetch replies
\par     replies_raw = substrate_adapter.get_ticket_replies(ticket_id)
\par     replies: List[TicketReplyModel] = [
\par         TicketReplyModel(
\par             id=r.id,
\par             ticket_id=r.ticket_id,
\par             author=r.author,
\par             body=r.body,
\par             created_at=r.created_at,
\par         )
\par         for r in replies_raw
\par     ]
\par 
\par     # 4. Fetch V10 payload (normalized + raw)
\par     v10_norm, v10_raw = schema_v10.load_ticket(ticket.synthetic_id)
\par 
\par     v10 = V10PayloadModel(
\par         normalized=v10_norm,
\par         raw=v10_raw,
\par     )
\par 
\par     # 5. Fetch chain context (block, extrinsic, events)
\par     block = explorer.block_lens.get_block_summary(
\par         block_number=ticket.block_number
\par     )
\par     extrinsic = explorer.extrinsic_lens.get_extrinsic_summary(
\par         block_number=ticket.block_number,
\par         extrinsic_index=ticket.extrinsic_index,
\par     )
\par     events_raw = explorer.block_lens.get_events_for_extrinsic(
\par         block_number=ticket.block_number,
\par         extrinsic_index=ticket.extrinsic_index,
\par     )
\par 
\par     events: List[EventSummaryModel] = [
