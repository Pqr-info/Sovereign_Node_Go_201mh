\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  1. ChatMessage model
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par data class ChatMessage(
\par     val id: Long,
\par     val sender: String,   // "user" or "agent"
\par     val text: String,
\par     val timestamp: Long
\par )
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  2. Retrofit API interface
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par interface ChatApi \{
\par 
\par     @POST("/chat/send")
\par     suspend fun sendMessage(@Body body: Map<String, String>): Response<Unit>
\par 
\par     @GET("/chat/sync")
\par     suspend fun syncMessages(@Query("since_id") sinceId: Long): List<ChatMessageDto>
\par \}
\par 
\par data class ChatMessageDto(
\par     val id: Long,
\par     val sender: String,
\par     val text: String,
\par     val timestamp: Long
\par )
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  3. ChatRepository
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par class ChatRepository(
\par     private val api: ChatApi
\par ) \{
\par 
\par     suspend fun sendMessage(text: String) \{
\par         api.sendMessage(mapOf("text" to text))
\par     \}
\par 
\par     suspend fun syncMessages(sinceId: Long): List<ChatMessage> \{
\par         return api.syncMessages(sinceId).map \{
\par             ChatMessage(
\par                 id = it.id,
\par                 sender = it.sender,
\par                 text = it.text,
\par                 timestamp = it.timestamp
\par             )
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  4. ChatViewModel (with polling loop)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par class ChatViewModel(
\par     private val repository: ChatRepository
\par ) : ViewModel() \{
\par 
\par     private val _messages = MutableStateFlow<List<ChatMessage>>(emptyList())
\par     val messages: StateFlow<List<ChatMessage>> = _messages
\par 
\par     private val _input = MutableStateFlow("")
\par     val input: StateFlow<String> = _input
\par 
\par     private var lastMessageId: Long = 0
\par 
\par     init \{
\par         startPolling()
\par     \}
\par 
\par     private fun startPolling() \{
\par         viewModelScope.launch \{
\par             while (isActive) \{
\par                 try \{
\par                     val newMessages = repository.syncMessages(lastMessageId)
\par                     if (newMessages.isNotEmpty()) \{
\par                         lastMessageId = newMessages.maxOf \{ it.id \}
\par                         _messages.value = _messages.value + newMessages
\par                     \}
\par                 \} catch (_: Exception) \{
\par                     // ignore errors, keep polling
\par                 \}
\par                 delay(2000L)
\par             \}
\par         \}
\par     \}
\par 
\par     fun updateInput(text: String) \{
\par         _input.value = text
\par     \}
\par 
\par     fun sendMessage() \{
\par         val text = _input.value.trim()
\par         if (text.isEmpty()) return
\par 
\par         viewModelScope.launch \{
\par             repository.sendMessage(text)
\par             _input.value = ""
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  5. ChatScreen (Jetpack Compose UI)
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Composable
\par fun ChatScreen(
\par     viewModel: ChatViewModel,
\par     modifier: Modifier = Modifier
\par ) \{
\par     val messages by viewModel.messages.collectAsState()
\par     val input by viewModel.input.collectAsState()
\par 
\par     Column(
\par         modifier = modifier
\par             .fillMaxSize()
\par             .testTag("chat_screen_root")
\par             .padding(12.dp)
\par     ) \{
\par 
\par         LazyColumn(
\par             modifier = Modifier
\par                 .weight(1f)
\par                 .fillMaxWidth()
\par                 .testTag("chat_message_list"),
\par             reverseLayout = true
\par         ) \{
\par             items(messages.reversed()) \{ msg ->
\par                 ChatBubble(msg)
\par             \}
\par         \}
\par 
\par         Row(
\par             modifier = Modifier
\par                 .fillMaxWidth()
\par                 .padding(top = 8.dp),
\par             verticalAlignment = Alignment.CenterVertically
\par         ) \{
\par             OutlinedTextField(
\par                 value = input,
\par                 onValueChange = \{ viewModel.updateInput(it) \},
\par                 modifier = Modifier
\par                     .weight(1f)
\par                     .testTag("chat_input"),
\par                 placeholder = \{ Text("Type a message\'85") \}
\par             )
\par 
\par             Spacer(Modifier.width(8.dp))
\par 
\par             Button(
\par                 onClick = \{ viewModel.sendMessage() \},
\par                 modifier = Modifier.testTag("chat_send_button")
\par             ) \{
\par                 Text("Send")
\par             \}
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  6. ChatBubble composable
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Composable
\par fun ChatBubble(msg: ChatMessage) \{
\par     val isUser = msg.sender == "user"
\par 
\par     Row(
\par         modifier = Modifier.fillMaxWidth(),
\par         horizontalArrangement = if (isUser) Arrangement.End else Arrangement.Start
\par     ) \{
\par         Surface(
\par             color = if (isUser) Color(0xFFDCF8C6) else Color(0xFFEFEFEF),
\par             shape = RoundedCornerShape(12.dp),
\par             modifier = Modifier.padding(4.dp)
\par         ) \{
\par             Text(
\par                 msg.text,
\par                 modifier = Modifier.padding(10.dp),
\par                 style = MaterialTheme.typography.bodyMedium
\par             )
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  7. Navigation entry
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 In your NavHost:
\par kotlin
\par composable("chat") \{
\par     ChatScreen(viewModel = chatViewModel)
\par \}
\par Add a button or tab:
\par kotlin
\par IconButton(onClick = \{ navController.navigate("chat") \}) \{
\par     Icon(Icons.Default.Chat, contentDescription = "Chat")
\par \}
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  8. Retrofit client for ChatApi
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par fun provideChatApi(baseUrl: String): ChatApi \{
\par     val client = provideOkHttpClient() // includes logging interceptor
\par     val retrofit = Retrofit.Builder()
\par         .baseUrl(baseUrl)
\par         .client(client)
\par         .addConverterFactory(MoshiConverterFactory.create())
\par         .build()
\par 
\par     return retrofit.create(ChatApi::class.java)
\par \}
\par }{\rtlch\fcs1 \ab\af44 \ltrch\fcs0 \b\f44\insrsid7026199\charrsid7026199 \u-10179\'3f\u-8218\'3f}{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199  9. Wire it into your DI / App container
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par val chatApi = provideChatApi("http://192.168.12.110:8000")
\par val chatRepository = ChatRepository(chatApi)
\par val chatViewModel = ChatViewModel(chatRepository)
