\par 
\par   useEffect(() => \{
\par     const init = async () => \{
\par       const provider = new WsProvider("ws://127.0.0.1:9944");
\par       const api = await ApiPromise.create(\{ provider \});
\par       setApi(api);
\par     \};
\par     init();
\par   \}, []);
\par 
\par   const connectWallet = async () => \{
\par     const extensions = await web3Enable("Jetweb Time Machine");
\par     if (!extensions.length) return;
\par     const accounts = await web3Accounts();
\par     setAccounts(accounts);
\par     if (accounts[0]) setSelected(accounts[0].address);
\par   \};
