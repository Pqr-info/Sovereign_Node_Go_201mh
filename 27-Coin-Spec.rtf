\par data class ChainHeadTickerUi(
\par     val bestNumber: Long,
\par     val finalizedNumber: Long,
\par     val isSyncing: Boolean
\par )
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 2. ViewModel (polling backend / MCP)
