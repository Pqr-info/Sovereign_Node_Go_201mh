\par @Composable
\par fun TicketLensScreen(
\par     lens: TicketLensUi?,
\par     onNavigateToTicket: (Long) -> Unit,
\par     onNavigateToAgent: (String) -> Unit,
\par     onNavigateToDecision: (Long) -> Unit
\par ) \{
\par     if (lens == null) \{
\par         Text("Loading ticket\'85", modifier = Modifier.testTag("ticket_lens_loading"))
\par         return
\par     \}
\par 
\par     Column(
\par         modifier = Modifier
\par             .fillMaxSize()
\par             .padding(16.dp)
\par             .testTag("ticket_lens_root"),
\par         verticalArrangement = Arrangement.spacedBy(12.dp)
\par     ) \{
\par 
\par         TicketHeader(lens.metadata)
\par         TicketRelationsSection(lens.relations, onNavigateToTicket, onNavigateToAgent, onNavigateToDecision)
\par         TicketRepliesSection(lens.replies)
\par         TicketChainContextSection(lens.chain)
\par         TicketV10Section(lens.v10)
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 Relations Section
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Composable
\par fun TicketRelationsSection(
\par     relations: List<RelationEdgeUi>,
\par     onTicket: (Long) -> Unit,
\par     onAgent: (String) -> Unit,
\par     onDecision: (Long) -> Unit
\par ) \{
\par     Column(
\par         modifier = Modifier.testTag("ticket_relations_section"),
\par         verticalArrangement = Arrangement.spacedBy(8.dp)
\par     ) \{
\par         Text("Relations", style = MaterialTheme.typography.titleMedium)
\par 
\par         relations.forEach \{ edge ->
\par             RelationRow(edge, onTicket, onAgent, onDecision)
\par         \}
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 RelationRow
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Composable
\par fun RelationRow(
\par     edge: RelationEdgeUi,
\par     onTicket: (Long) -> Unit,
\par     onAgent: (String) -> Unit,
\par     onDecision: (Long) -> Unit
\par ) \{
\par     Row(
\par         modifier = Modifier
\par             .fillMaxWidth()
\par             .testTag("relation_row_$\{edge.id\}")
\par             .clickable \{
\par                 when (edge.to) \{
\par                     is RelationTargetUi.Ticket -> onTicket(edge.to.id)
\par                     is RelationTargetUi.Agent -> onAgent(edge.to.name)
\par                     is RelationTargetUi.Decision -> onDecision(edge.to.id)
\par                 \}
\par             \}
\par     ) \{
\par         Text("$\{edge.kind\}: $\{edge.to.label\}", style = MaterialTheme.typography.bodyMedium)
\par     \}
\par \}
