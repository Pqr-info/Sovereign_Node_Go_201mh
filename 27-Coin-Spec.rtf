\par class FailureReporter:
\par     def __init__(self, backend_base_url: str):
\par         self.backend_base_url = backend_base_url
\par 
\par     def report_failure(self, scenario: Scenario, step: Step, index: int, error: str):
\par         ticket_payload = \{
\par             "schema_version": "PQR_TICKET_V10",
\par             "summary": f"Scenario failure: \{scenario.name\}",
\par             "description": f"Step \{index\} (\{step.action\}) failed: \{error\}",
\par             "metadata": \{
\par                 "scenario": scenario.name,
\par                 "step_index": index,
\par                 "step": step.__dict__,
\par             \},
\par         \}
\par         # call your existing archive_ticket endpoint
\par         requests.post(f"\{self.backend_base_url\}/archive_ticket", json=ticket_payload)
