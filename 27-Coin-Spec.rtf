\par {\listtext\pard\plain\ltrpar \rtlch\fcs1 \af31507 \ltrch\fcs0 \f3\fs20\kerning2\insrsid7026199\charrsid7026199 \loch\af3\dbch\af31506\hich\f3 \'b7\tab}espresso \u8594\'3f thin wrapper around Espresso matchers
