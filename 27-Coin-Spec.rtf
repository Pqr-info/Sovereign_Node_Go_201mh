\par #[pallet::storage]
\par pub type Tickets<T: Config> =
\par     StorageMap<_, Blake2_128Concat, TicketId, TicketMetadata, OptionQuery>;
\par 
\par #[pallet::storage]
\par pub type TicketRelations<T: Config> =
\par     StorageMap<_, Blake2_128Concat, TicketId, BoundedVec<RelationEdge, T::MaxRelationsPerTicket>, ValueQuery>;
\par 
\par #[pallet::storage]
\par pub type NextTicketId<T: Config> =
\par     StorageValue<_, TicketId, ValueQuery>;
