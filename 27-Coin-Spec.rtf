\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Composable
\par fun BlockLensRoot(
\par     lens: BlockLensUi?,
\par     onNavigateToBlock: (BlockRefUi) -> Unit,
\par     modifier: Modifier = Modifier
\par ) \{
\par     Column(
\par         modifier = modifier
\par             .fillMaxWidth()
\par             .testTag("block_lens_root")
\par             .padding(16.dp),
\par         verticalArrangement = Arrangement.spacedBy(12.dp)
\par     ) \{
\par         if (lens == null || lens.status != "ok") \{
\par             Text("No block context available", style = MaterialTheme.typography.bodyMedium)
\par             return@Column
\par         \}
\par 
\par         BlockSummaryCard(lens.block)
\par         ChainHeadMiniPanel(lens.chainHead)
\par         BlockNavigationRow(lens.navigation, onNavigateToBlock)
\par         ExtrinsicsList(lens.extrinsics)
\par         EventsList(lens.events)
\par         TicketsInBlockList(lens.tickets)
\par     \}
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 3. Block summary card
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 kotlin
\par @Composable
\par fun BlockSummaryCard(block: BlockSummaryUi) \{
\par     Card(
\par         modifier = Modifier
\par             .fillMaxWidth()
\par             .testTag("block_summary_card")
\par     ) \{
\par         Column(modifier = Modifier.padding(12.dp)) \{
\par             Text("Block #$\{block.number\}", style = MaterialTheme.typography.titleMedium)
\par             Text("Hash: $\{block.hash\}", style = MaterialTheme.typography.bodySmall)
\par             Text("Parent: $\{block.parentHash\}", style = MaterialTheme.typography.bodySmall)
\par             block.author?.let \{ Text("Author: $it", style = MaterialTheme.typography.bodySmall) \}
\par             block.timestamp?.let \{ Text("Timestamp: $it", style = MaterialTheme.typography.bodySmall) \}
\par             Spacer(Modifier.height(8.dp))
