\par kotlin
\par class ChainHeadTickerViewModel(
\par     private val repository: ChainHeadRepository
\par ) : ViewModel() \{
\par 
\par     private val _state = MutableStateFlow<ChainHeadTickerUi?>(null)
\par     val state: StateFlow<ChainHeadTickerUi?> = _state
\par 
\par     init \{
\par         viewModelScope.launch \{
\par             while (isActive) \{
\par                 try \{
\par                     val head = repository.getChainHead()
\par                     _state.value = ChainHeadTickerUi(
\par                         bestNumber = head.bestNumber,
\par                         finalizedNumber = head.finalizedNumber,
\par                         isSyncing = head.isSyncing
\par                     )
\par                 \} catch (_: Exception) \{
\par                     // keep last known state, or set null
\par                 \}
\par                 delay(1000L) // 1s tick
\par             \}
\par         \}
\par     \}
\par \}
\par ChainHeadRepository.getChainHead() should return your existing ChainHeadUi or equivalent.
