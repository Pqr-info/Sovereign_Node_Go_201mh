\par             horizontalArrangement = Arrangement.SpaceBetween,
\par             verticalAlignment = Alignment.CenterVertically
\par         ) \{
\par             Text(
\par                 text = "Head #$\{ticker.bestNumber\}",
\par                 style = MaterialTheme.typography.bodyMedium,
\par                 color = Color.White
\par             )
\par             Text(
\par                 text = "Finalized #$\{ticker.finalizedNumber\}",
\par                 style = MaterialTheme.typography.bodySmall,
\par                 color = Color.White.copy(alpha = 0.85f)
\par             )
\par             Text(
\par                 text = if (ticker.isSyncing) "Syncing\'85" else "Healthy",
\par                 style = MaterialTheme.typography.bodySmall,
\par                 color = Color.White
\par             )
\par         \}
\par     \}
\par \}
