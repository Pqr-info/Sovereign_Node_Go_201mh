\par     if (state == null) return
\par 
\par     val ticker = state!!
\par 
\par     Surface(
\par         modifier = modifier
\par             .fillMaxWidth()
\par             .testTag("chain_head_ticker_overlay"),
\par         color = if (ticker.isSyncing) Color(0xFF665500) else Color(0xFF004422),
\par         tonalElevation = 4.dp
\par     ) \{
\par         Row(
\par             modifier = Modifier
