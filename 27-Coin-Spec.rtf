\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 Here\rquote s a clean, extensible pallet layout that encodes your V10 ticket metadata and the 8\_layer relational graph directly on-chain\emdash without pretending Substrate is SQL.
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 1. Core types
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 rust
\par pub type TicketId = u64;
\par pub type AgentId = BoundedVec<u8, ConstU32<64>>; // e.g. "antigravity", "gemma", "alan"
\par pub type RelationId = u64;
\par 
\par #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par pub enum RelationTarget \{
\par     Ticket(TicketId),
\par     Agent(AgentId),
\par     Decision(TicketId), // or separate DecisionId if you split decisions
\par \}
\par 
\par #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par pub enum RelationKind \{
\par     DependsOn,      // ticket \u8594\'3f ticket
\par     Mentions,       // ticket \u8594\'3f agent
\par     AssignedTo,     // ticket \u8594\'3f agent
\par     DerivedFrom,    // ticket \u8594\'3f decision/evidence
\par     DuplicateOf,    // ticket \u8594\'3f ticket
\par     RelatedTo,      // generic edge
\par \}
\par 
\par #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par pub struct RelationEdge \{
\par     pub id: RelationId,
\par     pub from: TicketId,
\par     pub to: RelationTarget,
\par     pub kind: RelationKind,
\par \}
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 2. V10 ticket metadata on-chain
\par }{\rtlch\fcs1 \af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 You already have V10 normalization off-chain; on-chain we store the }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 normalized summary + references}{\rtlch\fcs1 
\af31507 \ltrch\fcs0 \insrsid7026199\charrsid7026199 , not the entire raw JSON.
\par rust
\par #[derive(Encode, Decode, TypeInfo, Clone, PartialEq, Eq)]
\par pub struct TicketMetadata \{
\par     pub ticket_id: TicketId,
\par     pub synthetic_id: BoundedVec<u8, ConstU32<64>>, // "TICKET-SYNTH-xxx"
\par     pub title: BoundedVec<u8, ConstU32<256>>,
\par     pub priority: u8,
\par     pub status: BoundedVec<u8, ConstU32<32>>,       // "open", "closed", etc.
\par     pub created_at: u64,                            // unix timestamp
\par     pub created_by: AgentId,                        // "alan", "antigravity"
\par     pub assigned_to: Option<AgentId>,               // primary agent
\par     pub block_number: u32,                          // where it was archived
\par     pub extrinsic_index: u32,                       // index in block
\par \}
\par You can add more fields as needed (tags, category, etc.), but this is enough to anchor the ticket in the chain and link it to the V10 off-chain payload.
\par }{\rtlch\fcs1 \ab\af31507 \ltrch\fcs0 \b\insrsid7026199\charrsid7026199 3. Storage layout
