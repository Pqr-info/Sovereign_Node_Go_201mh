47: // BindFirehoseStream attaches the stream handlers to the engine
48: func (e *ArbitrageEngine) BindFirehoseStream(client *stream.StocksClient) {
49: 	client.SubscribeToQuotes(func(q stream.Quote) {
50: 		price := (q.BidPrice + q.AskPrice) / 2.0
51: 		e.RealTimePrices[q.Symbol] = price
52: 		// In a real scenario we'd use Trades for volume, but we simulate volume logic here
53: 		e.RealTimeVolume[q.Symbol] = float64(q.BidSize + q.AskSize) 
54: 		e.MarketSniperTick() // Run the sniper on every quote
55: 	}, "GOOG", "GOOGL")
56: }
