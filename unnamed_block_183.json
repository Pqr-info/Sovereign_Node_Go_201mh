101: func (e *ArbitrageEngine) ExecuteAlpacaLeg(symbol string, side alpaca.Side) {
102: 	log.Printf("🤖 [Alpaca Leg] AUTONOMOUS EXECUTION: %v %s", side, symbol)
103: 	
