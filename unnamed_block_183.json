58: // MarketSniperTick is the high-speed algorithm resurrected from the user's github
59: func (e *ArbitrageEngine) MarketSniperTick() {
60: 	for _, pair := range e.ActivePairs {
61: 		priceA := e.RealTimePrices[pair.AssetA]
62: 		priceB := e.RealTimePrices[pair.AssetB]
63: 
64: 		if priceA == 0 || priceB == 0 {
65: 			continue // Awaiting real-time tick
66: 		}
67: 
68: 		spread := priceA - priceB
69: 		zScore := (spread - pair.Mean) / pair.StdDev
70: 
71: 		if zScore > 2.0 {
72: 			// Asset A is overvalued relative to B
73: 			if e.WhaleWatcherConfirm(pair.AssetA, pair.AssetB) {
74: 				log.Printf("[MarketSniper] 🎯 Pair %s/%s Z-Score: %.2f! Executing Arbitrage.", pair.AssetA, pair.AssetB, zScore)
75: 				e.ExecuteAlpacaLeg(pair.AssetB, alpaca.Buy) // Long undervalued
76: 				e.QueueSchwabTrade(pair.AssetA, 50)             // Short overvalued on Schwab
77: 			}
78: 		} else if zScore < -2.0 {
79: 			// Asset A is undervalued relative to B
80: 			if e.WhaleWatcherConfirm(pair.AssetA, pair.AssetB) {
81: 				log.Printf("[MarketSniper] 🎯 Pair %s/%s Z-Score: %.2f! Executing Arbitrage.", pair.AssetA, pair.AssetB, zScore)
82: 				e.ExecuteAlpacaLeg(pair.AssetA, alpaca.Buy) // Long undervalued
83: 				e.QueueSchwabTrade(pair.AssetB, 50)             // Short overvalued on Schwab
84: 			}
85: 		}
86: 	}
87: }
88: 
