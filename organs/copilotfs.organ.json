{
  "name": "CopilotFS",
  "id": "organ.copilotfs.phase24",
  "version": "24.0.0",
  "type": "filesystem",
  "mount_path": "C:\\pqr.info\\copilotfs",
  "source": {
    "kind": "rclone_local",
    "remote_name": "copilotfs",
    "bridge_output_path": "C:\\Users\\theal\\copilot-bridge\\output"
  },
  "subsystems": [
    "Governance",
    "TSRE",
    "MEV",
    "Auditor"
  ],
  "policies": {
