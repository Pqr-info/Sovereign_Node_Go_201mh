1: # MEV Protocol — Rust Core Engine
2: #
3: # Multi-stage build: compile in rust:1.75 → copy binary to slim Debian runtime.
4: # Final image is ~80 MB with only the binary, TLS certs, and OpenSSL.
5: #
6: # Build:  docker build -f docker/Dockerfile -t mev-engine .
