8: 
9: # ── Stage 1: Build ───────────────────────────────────────────────────
10: FROM rust:1.75-slim-bookworm as builder
11: 
12: WORKDIR /build
13: 
14: # Install build dependencies (OpenSSL for TLS, build-essential for cc crate)
15: RUN apt-get update && apt-get install -y \
16:     build-essential \
17:     pkg-config \
18:     libssl-dev \
19:     && rm -rf /var/lib/apt/lists/*
20: 
21: COPY core/ ./
22: 
23: # Release build with LTO and single codegen unit (matches Cargo.toml profile)
24: RUN cargo build --release
25: 
26: # ── Stage 2: Runtime ─────────────────────────────────────────────────
27: FROM debian:bookworm-slim
28: 
29: WORKDIR /app
30: 
31: # Minimal runtime dependencies: TLS certificates + OpenSSL shared lib
32: RUN apt-get update && apt-get install -y \
33:     ca-certificates \
34:     libssl3 \
35:     && rm -rf /var/lib/apt/lists/*
36: 
37: COPY --from=builder /build/target/release/mev-engine /app/
38: 
39: # Run as non-root user (UID 1000) to limit blast radius if compromised
40: RUN useradd -m -u 1000 mev
41: USER mev
42: 
43: # Liveness check: verify the process is running
44: HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
45:     CMD pgrep mev-engine || exit 1
46: 
