234: // ServeMetrics starts the Prometheus metrics HTTP server
235: func ServeMetrics(addr string) {
236: 	mux := http.NewServeMux()
237: 	mux.Handle("/metrics", corsMiddleware(promhttp.Handler()))
238: 
239: 	server := &http.Server{
240: 		Addr:    addr,
241: 		Handler: mux,
242: 	}
243: 
244: 	go func() {
245: 		log.Info().Str("addr", addr).Msg("Metrics server starting")
246: 		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
247: 			log.Error().Err(err).Msg("Metrics server error")
248: 		}
249: 	}()
250: }
251: 
252: func corsMiddleware(next http.Handler) http.Handler {
253: 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
254: 		w.Header().Set("Access-Control-Allow-Origin", "*")
255: 		w.Header().Set("Access-Control-Allow-Methods", "GET, OPTIONS")
256: 		w.Header().Set("Access-Control-Allow-Headers", "Content-Type")
257: 		if r.Method == http.MethodOptions {
258: 			w.WriteHeader(http.StatusNoContent)
259: 			return
260: 		}
261: 		next.ServeHTTP(w, r)
262: 	})
263: }
