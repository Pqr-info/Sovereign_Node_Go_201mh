153: // consumePipeline reads classified transactions from the pipeline and
154: // forwards them to the Rust MEV core via gRPC for opportunity detection.
155: // Detected opportunities are logged and bundles are relayed.
156: func consumePipeline(
157: 	ctx context.Context,
158: 	p *pipeline.Pipeline,
159: 	gasOracle *gas.Oracle,
160: 	blockWatcher *block.Watcher,
161: 	bundleExecutor *bundleExecutor,
162: ) {
163: 	var strategyClient *strategy.Client
164: 	var lastConnectAttempt time.Time
165: 
166: 	connectStrategyClient := func() *strategy.Client {
167: 		if time.Since(lastConnectAttempt) < 2*time.Second {
168: 			return strategyClient
169: 		}
170: 		lastConnectAttempt = time.Now()
171: 
172: 		client, err := strategy.NewClient(strategy.DefaultConfig())
173: 		if err != nil {
174: 			log.Debug().Err(err).Msg("Rust core gRPC unavailable")
175: 			return nil
176: 		}
177: 
178: 		log.Info().Msg("Connected to Rust MEV core via gRPC")
179: 		return client
180: 	}
181: 
182: 	for {
183: 		select {
184: 		case <-ctx.Done():
185: 			if strategyClient != nil {
186: 				sent, recv, errs := strategyClient.Stats()
187: 				log.Info().
188: 					Uint64("sent", sent).
189: 					Uint64("opportunities", recv).
190: 					Uint64("errors", errs).
191: 					Msg("Strategy client shutting down")
192: 				_ = strategyClient.Close()
193: 			}
194: 			return
195: 
196: 		case tx, ok := <-p.OutputChan():
197: 			if !ok {
198: 				return
199: 			}
200: 
201: 			if strategyClient == nil {
202: 				strategyClient = connectStrategyClient()
203: 			}
204: 			if strategyClient == nil {
205: 				log.Debug().Str("hash", tx.Tx.Hash.Hex()).Msg("Classified tx (Rust core offline)")
206: 				continue
207: 			}
208: 
209: 			// Prepare target block and base fee from live oracles
210: 			var baseFeeBytes []byte
211: 			if estimate := gasOracle.GetEstimate(); estimate != nil && estimate.BaseFee != nil {
212: 				baseFeeBytes = estimate.BaseFee.Bytes()
213: 			}
214: 			targetBlock := blockWatcher.TargetBlock()
215: 
216: 			// Build gRPC request from classified tx
217: 			var toBytes []byte
218: 			if tx.Tx.To != nil {
219: 				toBytes = tx.Tx.To.Bytes()
220: 			}
221: 
222: 			reqCtx, reqCancel := context.WithTimeout(ctx, 100*time.Millisecond)
223: 			result, err := strategyClient.DetectOpportunity(
224: 				reqCtx,
225: 				tx.Tx.Hash.Bytes(),
226: 				tx.Tx.From.Bytes(),
227: 				toBytes,
228: 				tx.Tx.Value,
229: 				tx.Tx.GasPrice,
230: 				tx.Tx.GasLimit,
231: 				tx.Tx.Input,
232: 				tx.Tx.Nonce,
233: 				int32(tx.Class),
234: 				targetBlock,
235: 				baseFeeBytes,
236: 			)
237: 			reqCancel()
238: 
239: 			if err != nil {
240: 				log.Debug().Err(err).Str("hash", tx.Tx.Hash.Hex()).Msg("Detection RPC failed")
241: 				_ = strategyClient.Close()
242: 				strategyClient = nil
243: 				continue
244: 			}
245: 
246: 			// Log any detected opportunities
247: 			strategy.LogOpportunities(result, tx.Tx.Hash.Hex())
248: 
249: 			// If bundles were built, submit to relay
250: 			if result.Found {
251: 				for _, opp := range result.Opportunities {
252: 					if opp.Bundle != nil && len(opp.Bundle.Transactions) > 0 {
253: 						log.Info().
254: 							Str("hash", tx.Tx.Hash.Hex()).
255: 							Int("bundleTxs", len(opp.Bundle.Transactions)).
256: 							Uint64("targetBlock", opp.Bundle.TargetBlock).
257: 							Msg("Bundle ready for relay submission")
258: 
259: 						submitCtx, submitCancel := context.WithTimeout(ctx, 5*time.Second)
260: 						err := bundleExecutor.HandleOpportunityBundle(
261: 							submitCtx,
262: 							opp,
263: 							targetBlock,
264: 							gasOracle.GetEstimate(),
265: 						)
266: 						submitCancel()
267: 						if err != nil {
268: 							log.Warn().Err(err).Str("hash", tx.Tx.Hash.Hex()).Msg("Bundle execution failed")
269: 						}
270: 					}
271: 				}
272: 			}
273: 		}
274: 	}
275: }
