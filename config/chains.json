37: 	GasPriceGwei       float64 `json:"gas_price_gwei"`
38: 	SimulatedArbsCount int64   `json:"simulated_arbs_count"`
39: }
40: 
41: type Adapter struct {
42: 	mu        sync.RWMutex
43: 	startTime time.Time
44: 	config    Config
45: 	status    HealthStatus
46: }
47: 
48: func NewAdapter(cfg Config) *Adapter {
49: 	return &Adapter{
50: 		startTime: time.Now(),
51: 		config:    cfg,
52: 		status: HealthStatus{
53: 			Status:    "HEALTHY",
54: 			BuildTime: time.Now().Format(time.RFC3339),
55: 			Anomaly:   false,
56: 			Metrics: Metrics{
57: 				LatencyMs:          1.2,
58: 				Tps:                150.0,
59: 				GasPriceGwei:       25.5,
60: 				SimulatedArbsCount: 0,
61: 			},
62: 		},
63: 	}
64: }
65: 
66: func (a *Adapter) StartServer(port string) error {
67: 	http.HandleFunc("/health", a.handleHealth)
68: 	http.HandleFunc("/config", a.handleConfig)
69: 	http.HandleFunc("/healer/trigger-recovery", a.handleRecovery)
70: 
71: 	log.Info().Msgf("Mesh Citizen Shell adapter starting on port %s", port)
72: 	return http.ListenAndServe(":"+port, nil)
73: }
74: 
75: func (a *Adapter) handleHealth(w http.ResponseWriter, r *http.Request) {
76: 	a.mu.RLock()
77: 	defer a.mu.RUnlock()
78: 
79: 	a.status.Uptime = time.Since(a.startTime).String()
80: 	a.status.Timestamp = time.Now()
81: 
82: 	w.Header().Set("Content-Type", "application/json")
83: 	_ = json.NewEncoder(w).Encode(a.status)
84: }
85: 
86: func (a *Adapter) handleConfig(w http.ResponseWriter, r *http.Request) {
87: 	a.mu.RLock()
88: 	defer a.mu.RUnlock()
89: 
90: 	w.Header().Set("Content-Type", "application/json")
91: 	_ = json.NewEncoder(w).Encode(a.config)
92: }
93: 
94: func (a *Adapter) handleRecovery(w http.ResponseWriter, r *http.Request) {
95: 	a.mu.Lock()
96: 	defer a.mu.Unlock()
97: 
98: 	log.Warn().Msg("HealerAgentV2 triggered recovery pipeline! Re-initializing memory states...")
99: 	a.status.Anomaly = false
100: 	a.status.Status = "RECOVERED"
101: 
102: 	w.WriteHeader(http.StatusOK)
103: 	_, _ = w.Write([]byte(`{"status":"recovered"}`))
104: }
105: 
106: func main() {
107: 	port := flag.String("port", "8080", "Port to run the MCSH adapter on")
108: 	flag.Parse()
109: 
110: 	zerolog.TimeFieldFormat = zerolog.TimeFormatUnix
111: 	log.Logger = log.Output(zerolog.ConsoleWriter{Out: os.Stderr})
112: 
113: 	cfg := Config{
114: 		Name:    "MEV Engine",
115: 		ID:      "mev",
116: 		Version: "1.0.0",
117: 		Mode:    "simulation",
118: 	}
119: 
120: 	adapter := NewAdapter(cfg)
121: 	if err := adapter.StartServer(*port); err != nil {
122: 		log.Fatal().Err(err).Msg("Failed to start MCSH adapter")
123: 	}
124: }
