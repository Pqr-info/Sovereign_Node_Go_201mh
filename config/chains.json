26: func (g *TimeslipGenerator) GenerateTimeslip(epoch string, transform string) TimeslipSegment {
27: 	events := g.tme.GetEventsByEpoch(epoch)
28: 	if len(events) == 0 {
29: 		return TimeslipSegment{
30: 			BaseEpoch:    epoch,
31: 			SlipID:       "slip-" + epoch + "-empty",
32: 			Events:       []TemporalEvent{},
33: 			TransformTag: transform,
34: 		}
35: 	}
36: 
37: 	transformed := make([]TemporalEvent, len(events))
38: 	copy(transformed, events)
39: 
40: 	if transform == "shifted+5m" {
41: 		for i := range transformed {
42: 			transformed[i].Timestamp = transformed[i].Timestamp.Add(5 * time.Minute)
43: 		}
44: 	} else if transform == "compressed-2x" {
45: 		start := events[0].Timestamp
46: 		for i := range transformed {
47: 			delta := transformed[i].Timestamp.Sub(start)
48: 			transformed[i].Timestamp = start.Add(delta / 2)
49: 		}
50: 	}
51: 
52: 	start := transformed[0].Timestamp
53: 	end := transformed[len(transformed)-1].Timestamp
54: 
55: 	return TimeslipSegment{
56: 		BaseEpoch:    epoch,
57: 		SlipID:       "slip-" + epoch + "-" + transform,
58: 		Events:       transformed,
59: 		StartTime:    start,
60: 		EndTime:      end,
61: 		TransformTag: transform,
62: 	}
